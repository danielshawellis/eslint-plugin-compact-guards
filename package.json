{
  "name": "eslint-plugin-compact-guards",
  "version": "0.1.1",
  "description": "ESLint plugin enforcing compact guard clauses: no braces, with the return/throw keyword on the same line as the closing parenthesis of the condition.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "guard-clause",
    "early-return",
    "code-style"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielshawellis/eslint-plugin-compact-guards.git"
  },
  "bugs": {
    "url": "https://github.com/danielshawellis/eslint-plugin-compact-guards/issues"
  },
  "homepage": "https://github.com/danielshawellis/eslint-plugin-compact-guards#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test && node scripts/test-packed-package.mjs"
  },
  "peerDependencies": {
    "eslint": "^8.57.1 || ^9 || ^10"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/estree": "^1.0.5",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
